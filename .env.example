# Next.js is frontend-only in this architecture. It holds no database
# credentials, no LLM API keys, and no storage credentials — all of that
# lives in backend/.env.example. The only thing this app needs to know is
# where the FastAPI backend is, so next.config.ts can proxy /api/* requests
# to it (see the `rewrites()` block in next.config.ts).

# FastAPI backend base URL (server-side only — used by next.config.ts's
# rewrite and by lib/auth.ts's server-side backendFetch()).
# Local dev:   http://127.0.0.1:8000  (matches `uvicorn app.main:app --port 8000`)
# Production:  the backend's deployed URL (Railway/Render/Cloud Run/etc.)
BACKEND_API_URL="http://127.0.0.1:8000"
