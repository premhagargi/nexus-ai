# Database connection strings (Supabase PostgreSQL with pgvector)
DATABASE_URL="postgres://postgres.xxxxx:xxxxx@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://postgres.xxxxx:xxxxx@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Supabase Storage configuration (Service Role required for backend uploads)
NEXT_PUBLIC_SUPABASE_URL="https://xxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR..."

# AI and Embeddings
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSy..."

# Authentication (Custom JWT Secret)
JWT_SECRET="generate-a-strong-secret-key-here"

# Supabase S3 Storage Protocol
SUPABASE_S3_ENDPOINT="https://xxxxx.storage.supabase.co/storage/v1/s3"
SUPABASE_S3_ACCESS_KEY_ID="your-s3-access-key-id"
SUPABASE_S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"
